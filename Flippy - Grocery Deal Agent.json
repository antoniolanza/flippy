    {
      "parameters": {
        "jsCode": "// Merge the favourites list into the context the agent sees.\nconst state = $('Load State').first().json;\nconst favResponse = ($input.first().json && $input.first().json.response) || '';\n\nlet favouritesText = 'No favourites saved yet.';\nif (favResponse.indexOf('Saved favourites:') === 0) {\n  favouritesText = favResponse.replace('Saved favourites:\\n', '');\n}\n\nreturn [{\n  json: {\n    sessionId: state.sessionId,\n    userId: state.userId,\n    message: state.message,\n    favouritesText: favouritesText\n  }\n}];"
      },
