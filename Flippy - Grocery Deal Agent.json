      "parameters": {
        "jsCode": "// Normalize the incoming chat payload.\n// sessionId scopes conversation memory (new per chat); userId scopes favourites (stable per household).\n// Favourites live in the Manage Favourites sub-workflow's storage, so they are\n// fetched via the next node rather than read from this workflow's staticData.\nconst input = $input.first().json;\nconst sessionId = input.sessionId || 'default';\nconst userId = input.userId || 'household';\nconst message = input.chatInput || '';\n\nreturn [{\n  json: {\n    sessionId: sessionId,\n    userId: userId,\n    message: message,\n    action: 'list'\n  }\n}];"
      },
