    {
      "parameters": {
        "jsCode": "// One output item per favourite. If there are none, output nothing and the run ends here.\nlet favs = [];\ntry {\n  favs = JSON.parse($input.first().json.response || '[]');\n} catch (e) {\n  favs = [];\n}\n\nreturn favs\n  .filter(function(f) { return f && f.name; })\n  .map(function(f) { return { json: { query: f.name, store: f.store || null } }; });"
      },
      "id": "d1c35701-0004-4a00-9000-d4e5f6a1b2c3",
