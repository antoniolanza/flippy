      "id": "d1c35701-0005-4a00-9000-e5f6a1b2c3d4",
      "name": "Search Deals",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        768,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a compact plain-text digest: top 3 deals per favourite.\nconst sections = [];\n\nfor (const item of $input.all()) {\n  const resp = (item.json && item.json.response) || '';\n  const nameMatch = resp.match(/for \"([^\"]+)\"/);\n  const name = nameMatch ? nameMatch[1] : 'item';\n\n  const jsonStart = resp.indexOf('[');\n  let deals = [];\n  if (jsonStart !== -1) {\n    try { deals = JSON.parse(resp.slice(jsonStart)); } catch (e) { deals = []; }\n  }\n\n  if (!Array.isArray(deals) || deals.length === 0) {\n    sections.push(name + ': no deals this week');\n    continue;\n  }\n\n  const top = deals.slice(0, 3).map(function(d) {\n    let line = '  - ' + (d.name || name) + ' — ';\n    if (d.pricePrefix) line += d.pricePrefix + ' ';\n    line += d.price != null ? '$' + d.price : (d.priceText || '?');\n    if (d.priceSuffix) line += d.priceSuffix;\n    line += ' @ ' + (d.store || '?');\n    if (d.percentOff) line += ' (' + d.percentOff + '% off)';\n    return line;\n  });\n\n  sections.push(name.toUpperCase() + ':\\n' + top.join('\\n'));\n}\n\nconst body = sections.length\n  ? 'This week\\'s flyer deals on your favourites:\\n\\n' + sections.join('\\n\\n')\n  : 'No favourites saved yet — tell Flippy what you usually buy!';\n\nreturn [{ json: { body: body } }];"
      },
